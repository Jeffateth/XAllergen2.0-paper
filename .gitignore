# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Matplotlib cache ──────────────────────────────────────────────────────
.matplotlib/

# ── Colab / Google Drive runtime artifacts ────────────────────────────────
# (should not appear in a clean checkout, but guard against accidents)
/content/

# ── Operating system ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs and temporary files ──────────────────────────────────────────────
*.log
*.tmp
outputs/
external/
tmp_mmseqs/

# ── Local secrets and credentials ─────────────────────────────────────────
.env
.env.*
secrets.json
credentials.json
*.pem
*.key

# ── PyTorch / ML artifacts ────────────────────────────────────────────────
# .ckpt and .pkl are excluded (large intermediate artifacts).
# .pt checkpoint files ARE intentionally tracked in models/ for reproducibility.
*.ckpt
*.pkl

# ── MMseqs2 temporary directories ─────────────────────────────────────────
tmp_mmseqs*/
*_mmseqs_tmp/

# ── Large intermediate FASTA files (generated by nb01, cleaned up after) ──
data/positives.fasta
data/negatives.fasta
data/negatives_nr.fasta

# ── Editor / IDE ──────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── uv ────────────────────────────────────────────────────────────────────
# uv.lock IS intentionally tracked — it is the reproducibility artifact.
# Do not add uv.lock here.
